{
  "name": "dsh-edit-message",
  "version": "1.0.0",
  "description": "右键最新一条用户消息进行编辑，重发后标记上一条用户消息及其回答作废",
  "license": "MIT",
  "author": "starash07",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starash07/dsh-edit-message.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "message",
    "edit"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
